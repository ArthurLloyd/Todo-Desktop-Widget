{
  "name": "ms-todo-desktop-widget",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "test:theme": "node --test --experimental-strip-types tests/themeRuntime.test.ts tests/themeEditor.test.ts",
    "test:management": "node --test --experimental-strip-types tests/widgetView.test.ts tests/managementTheme.test.ts",
    "test:pane-resize": "node --test --experimental-strip-types tests/paneResize.test.ts",
    "test:ux": "node --test --experimental-strip-types tests/widgetPresentation.test.ts",
    "test:frontend": "npm run test:theme && npm run test:management && npm run test:pane-resize && npm run test:ux",
    "version:check": "node scripts/check-version.mjs",
    "release:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-preflight.ps1",
    "release:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-smoke-test.ps1",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --bundles app,dmg",
    "tauri:build:mac:widget": "./scripts/build-macos-with-widget.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
